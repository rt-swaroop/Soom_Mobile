{
  "extends": "@react-native/typescript-config",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "react-native.config.js"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ],
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {},
    "typeRoots": [
      "./node_modules/@types",
      "./declarations.d.ts"
    ]
  }
}